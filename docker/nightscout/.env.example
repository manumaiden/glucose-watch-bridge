# Copy to .env and set your own values. Never commit the real .env.

# At least 12 characters. The n8n workflow authenticates with SHA1(API_SECRET):
#   echo -n "<your API_SECRET>" | sha1sum
NIGHTSCOUT_API_SECRET=change_me_min_12_chars

# URL used to reach Nightscout (LAN address or your public https URL)
NIGHTSCOUT_BASE_URL=https://<NIGHTSCOUT_HOST>

# mmol/L or mg/dl
DISPLAY_UNITS=mmol/L
